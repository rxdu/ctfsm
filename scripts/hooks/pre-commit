#!/usr/bin/env bash
# pre-commit: auto-format staged C/C++ with the pinned clang-format and re-stage
# the result, so a commit is never the thing that introduces a format violation.
# Fast (per-file, no build needed). clang-tidy runs at pre-push, not here.
#
# Caveat: this formats the whole staged file and re-adds it, so if you partially
# staged a file (git add -p) that also needed reformatting, the reformat is
# staged in full. Rare; mentioned so it's never a surprise.
#
# Activate once per clone: scripts/hooks/install.sh
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

# Prefer the pinned venv binary, then an explicit override, then PATH.
CF="${CLANG_FORMAT:-}"
[ -z "$CF" ] && [ -x .venv/bin/clang-format ] && CF=.venv/bin/clang-format
[ -z "$CF" ] && CF=clang-format
command -v "$CF" >/dev/null 2>&1 || {
  echo "pre-commit: clang-format not found ('$CF') — skipping format (CI still gates)." >&2
  exit 0
}

# Staged, still-present C/C++ files (Added/Copied/Modified), NUL-safe.
mapfile -d '' files < <(git diff --cached --name-only --diff-filter=ACM -z \
  -- '*.hpp' '*.cpp' '*.cc' '*.cxx' '*.h')
[ ${#files[@]} -eq 0 ] && exit 0

"$CF" -i "${files[@]}"
git add -- "${files[@]}"
